# ============================================================================
linux-UFRII-drv-*.tar.gz
linux-UFRII-drv-v630-m17n/

# Generated root filesystem bundle — contains the Canon driver binaries.
# Produced by scripts/build-bundle.sh.
app/src/main/assets/rootfs.tar.gz
app/src/main/assets/rootfs.tar
app/src/main/assets/rootfs.version

